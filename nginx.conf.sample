# nginx example for serving the application from /todo/
# The application has no login of its own: protect it with HTTP authentication,
# and only serve it over HTTPS (generic version: webauth/samples/nginx.conf.sample).
location /todo/ {
    # only HTTPS, so that the password is never sent in cleartext
    # (remove this if TLS is terminated in front of nginx)
    if ($scheme != "https") { return 301 https://$host$request_uri; }

    # create with: htpasswd -B -C 12 -c /etc/nginx/todo.htpasswd <user>
    # (-B: bcrypt; the default, MD5, is much easier to guess offline)
    auth_basic "Todo";
    auth_basic_user_file /etc/nginx/todo.htpasswd;
    # There is no limit for wrong passwords. Slow guessing down with, in the http block:
    #   limit_req_zone $binary_remote_addr zone=todo_auth:10m rate=5r/s;
    # and here: limit_req zone=todo_auth burst=20 nodelay;
    # (or use fail2ban, see README.md)

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "same-origin" always;
    add_header Strict-Transport-Security "max-age=31536000" always;

    # never serve internal files directly
    location ~ ^/todo/(sql|scripts|secrets|tests|node_modules|lang|\.git|\.github)/ { return 404; }
    location ~ (/\.|~$|\.(sql|sh|ini|bak|swp|orig|md|yml|neon|lock|sample)$|/config[^/]*\.php$|/package(-lock)?\.json$) { return 404; }
    location ~ ^/todo/(session|todo-core|lang)\.php$ { return 404; }
    location ~ ^/todo/webauth/ { return 404; }
    location ~ ^/todo/queries/(db|date|tags|todo-list-query|recurrence|db-connect|endpoint|response|todo-input|limits|statistics-data)\.php$ { return 404; }

    # The client is made of ES modules (js/*.js). Only the URL of js/main.js has a version (assetUrl() in
    # todo-core.php); the modules it imports are fetched by their plain URLs, which a browser could keep
    # using after an update (an import map with versions would need an inline script, which the
    # Content-Security-Policy forbids). So the browser has to ask each time whether a module changed:
    # it gets 304 without the file if not (nginx answers conditional requests by itself).
    # "expires -1" sends "Cache-Control: no-cache"; add_header would be the other way, but a location
    # with an add_header of its own no longer inherits the add_header lines above. A plain prefix
    # location (no ^~) yields to the regular expression locations, so their rules stay in force.
    # Authentication is inherited from the enclosing location, the HTTPS redirect is not (if and
    # return are not inherited by nested locations): it is repeated here.
    location /todo/js/ {
        if ($scheme != "https") { return 301 https://$host$request_uri; }
        expires -1;
    }

    # the page was called statistik.php: old bookmarks keep working
    location = /todo/statistik.php { return 301 /todo/statistics.php; }

    location ~ \.php$ {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $request_filename;
        # the application rejects requests without an authenticated user
        fastcgi_param REMOTE_USER $remote_user;
        fastcgi_pass unix:/run/php/php-fpm.sock;
    }
}
