# Apache configuration (requires AllowOverride AuthConfig FileInfo Limit)
# The application has no login of its own: protect it with HTTP authentication,
# and only serve it over HTTPS (generic version: webauth/samples/htaccess.sample).

AuthType Basic
AuthName "Todo"
# create with: htpasswd -B -C 12 -c /path/outside/webroot/.htpasswd <user>
# (-B: bcrypt; the default, MD5, is much easier to guess offline)
AuthUserFile /path/outside/webroot/.htpasswd
# HTTPS is checked first, so that browsers are never asked for the password
# over plain HTTP.
# The request header X-Forwarded-Proto is NOT believed here: any client can send it.
# Behind a proxy which terminates TLS, set the HTTPS variable in the virtual host
# for requests from that proxy only, e.g. (adapt the address of the proxy):
#   SetEnvIfExpr "%{REMOTE_ADDR} -ipmatch '10.0.0.5' && %{HTTP:X-Forwarded-Proto} == 'https'" HTTPS=on
<RequireAll>
    Require expr "%{HTTPS} == 'on' || %{ENV:HTTPS} == 'on'"
    Require valid-user
</RequireAll>
# There is no limit for wrong passwords: use fail2ban, mod_evasive or similar (see README.md).

# never serve internal files directly (webauth/ has its own .htaccess which denies everything)
RedirectMatch 404 ^.*/(sql|scripts|secrets|tests|node_modules|lang|\.git|\.github)(/|$)
# (FilesMatch also applies to requests with a trailing path like db.php/x, unlike
# a match on the request URI)
<FilesMatch "(^\.|~$|\.(sql|sh|ini|bak|swp|orig|md|yml|neon|lock|sample)$|^config.*\.php$|^package(-lock)?\.json$|^session\.php$|^todo-core\.php$|^lang\.php$)">
    Require all denied
</FilesMatch>
# the page was called statistik.php: old bookmarks keep working (redirected here, not by a PHP file,
# which would be one more file to protect)
RedirectMatch 301 ^(.*/)statistik\.php$ $1statistics.php

# helper scripts which are only included by the query endpoints
<FilesMatch "^(db|date|tags|todo-list-query|recurrence|db-connect|endpoint|response|todo-input|limits|statistics-data)\.php$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "same-origin"
    # ignored by browsers over plain HTTP
    Header always set Strict-Transport-Security "max-age=31536000"
    # The client is made of ES modules (js/*.js). Only the URL of js/main.js has a version
    # (assetUrl() in todo-core.php); the modules it imports are fetched by their plain URLs, which a
    # browser could keep using after an update (an import map with versions would need an inline script,
    # which the Content-Security-Policy forbids). So the browser has to ask each time whether a module
    # changed: it gets 304 without the file if not. Keep this in sync with nginx.conf.sample.
    <If "%{REQUEST_URI} =~ m#/js/[^/]+\.js$#">
        Header always set Cache-Control "no-cache"
    </If>
</IfModule>
