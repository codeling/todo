# static analysis of the PHP code, run by .github/workflows/tests.yml: phpstan analyse
parameters:
    level: 5
    paths:
        - .
    # constants of scripts which rely on their caller to load them (like MAX_TODO_LENGTH in
    # todo-input.php): PHPStan includes these files itself, so they must not have side effects
    bootstrapFiles:
        - queries/limits.php
    excludePaths:
        - node_modules (?)
        - vendor
        # PHPUnit tests of the library, run in its own repository (see README.md)
        - webauth/tests
        - config.php (?)
